generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConstructionSite {
  id        String         @id @default(cuid())
  name      String
  address   String?
  entries   JournalEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Employee {
  id        String         @id @default(cuid())
  fullName  String
  position  String
  isActive  Boolean        @default(true)
  entries   JournalEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WorkType {
  id          String         @id @default(cuid())
  name        String         @unique
  code        String         @unique
  defaultUnit String?
  isActive    Boolean        @default(true)
  entries     JournalEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model JournalEntry {
  id                 String           @id @default(cuid())
  constructionSiteId String
  constructionSite   ConstructionSite @relation(fields: [constructionSiteId], references: [id], onDelete: Cascade)
  workDate           DateTime         @db.Date
  workTypeId         String
  workType           WorkType         @relation(fields: [workTypeId], references: [id])
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id])
  volume             Decimal          @db.Decimal(12, 3)
  unit               String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([constructionSiteId, workDate])
}
